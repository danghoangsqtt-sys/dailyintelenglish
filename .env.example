DIE_GEMINI_API_KEY=

# Phase 18/D21: cloud (a multi-provider chain, Gemini first then OpenRouter -- see
# CLOUD_PROVIDER_ORDER below) is the default primary, local (Ollama) the automatic
# fallback. Setting DIE_AI_MODE to cloud/cloud_first also requires
# DIE_AI_ALLOW_CLOUD=true below, and at least one provider's key/model configured,
# or the effective mode stays "local" regardless (invariant 32/D24) -- so an
# install with no cloud key is fully unaffected by this default. A legacy
# gemini/hybrid value (from before Phase 18) migrates automatically.
# Task 18.11 (D31): defaults to "cloud_first" after Gate B-11's real PASS
# (docs/operations/phase18-gate-b11.md). Set to "local" to opt back out.
DIE_AI_MODE=cloud_first
# Plan Amendment C (Task 18.3): defaults to true so the Settings page can enable
# cloud. Set to false to fully disable cloud regardless of any other setting.
DIE_AI_ALLOW_CLOUD=true
DIE_OLLAMA_BASE_URL=http://127.0.0.1:11434
DIE_OLLAMA_MODEL=qwen3.5:9b
DIE_OLLAMA_CONTEXT=16384
DIE_OLLAMA_KEEP_ALIVE=5m

# Phase 18/D22-D24 -- the generic OpenAI-compatible cloud provider.
DIE_OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
DIE_OPENAI_COMPAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
DIE_OPENAI_COMPAT_API_KEY=
# Task 18.6 (D27): cut 150 -> 75s after Gate B-9's 7 cloud timeouts each burned
# the full 150s before the fallback ran (docs/operations/phase18-gate-b9.md).
DIE_AI_CLOUD_DEADLINE_SECONDS=75
# Task 18.6 (D27): OpenRouter's native models:[] chain, tried server-side within
# the one HTTP call on rate-limit/downtime. Comma-separated, empty disables it
# (primary model only).
DIE_OPENAI_COMPAT_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free

# Task 18.8 (D28, Amendment E; defaults revised by Amendment F's real provider
# probe, order flipped by Task 18.9/D30) -- a multi-provider free chain: gemini
# -> openrouter (above) -> local qwen. A provider with no key is skipped
# silently. DIE_GEMINI_API_KEY (top of
# this file) is reused as-is; Gemini dispatches as multiple model entries
# sharing that one key, each with its own circuit (free limits are per model).
# OpenCode Zen stays available to add manually (DIE_CLOUD_PROVIDER_ORDER) but
# isn't in the default order -- its free tier is restricted to its own client.
DIE_OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
DIE_OPENCODE_ZEN_API_KEY=
DIE_OPENCODE_ZEN_MODEL=
DIE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DIE_GEMINI_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
# Comma-separated dispatch order. Task 18.9 (D30): Gemini first -- Gate B-10 found it
# answered in ~4s at ~1.00x word target, while OpenRouter's free Nemotron timed out
# 16 times at 75s.
DIE_CLOUD_PROVIDER_ORDER=gemini,openrouter

DIE_APP_HOST=localhost
DIE_APP_PORT=8000
DIE_DEBUG=true

DIE_DATA_DIR=data
DIE_OMNIVOICE_MODEL_PATH=models/omnivoice

DIE_FFMPEG_PATH=ffmpeg
