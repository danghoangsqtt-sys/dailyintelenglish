GEMINI_API_KEY=your_gemini_api_key_here

# Optional TTS API keys (only needed if using cloud TTS)
GOOGLE_TTS_API_KEY=
AZURE_TTS_API_KEY=
AZURE_TTS_REGION=eastus

# App settings
APP_HOST=localhost
APP_PORT=8000
DATA_DIR=data
DEBUG=true

# OmniVoice settings
OMNIVOICE_MODEL_PATH=models/omnivoice
OMNIVOICE_DEVICE=cuda
OMNIVOICE_MAX_CONCURRENT=2

# ffmpeg path (if not in system PATH)
FFMPEG_PATH=ffmpeg
