DIE_GEMINI_API_KEY=

# Phase 18/D21: cloud (an OpenAI-compatible endpoint, OpenRouter by default) is the
# default primary, local (Ollama) the automatic fallback. Setting DIE_AI_MODE to
# cloud/cloud_first also requires DIE_AI_ALLOW_CLOUD=true below, and a key/model
# configured, or the effective mode stays "local" regardless (invariant 32/D24).
# A legacy gemini/hybrid value (from before Phase 18) migrates automatically.
DIE_AI_MODE=local
DIE_AI_ALLOW_CLOUD=false
DIE_OLLAMA_BASE_URL=http://127.0.0.1:11434
DIE_OLLAMA_MODEL=qwen3.5:9b
DIE_OLLAMA_CONTEXT=16384
DIE_OLLAMA_KEEP_ALIVE=5m
DIE_GEMINI_MODEL=

# Phase 18/D22-D24 -- the generic OpenAI-compatible cloud provider.
DIE_OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
DIE_OPENAI_COMPAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
DIE_OPENAI_COMPAT_API_KEY=
DIE_AI_CLOUD_DEADLINE_SECONDS=150

DIE_APP_HOST=localhost
DIE_APP_PORT=8000
DIE_DEBUG=true

DIE_DATA_DIR=data
DIE_OMNIVOICE_MODEL_PATH=models/omnivoice

DIE_FFMPEG_PATH=ffmpeg
