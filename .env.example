DIE_GEMINI_API_KEY=

# Phase 18/D21: cloud (an OpenAI-compatible endpoint, OpenRouter by default) is the
# default primary, local (Ollama) the automatic fallback. Setting DIE_AI_MODE to
# cloud/cloud_first also requires DIE_AI_ALLOW_CLOUD=true below, and a key/model
# configured, or the effective mode stays "local" regardless (invariant 32/D24).
# A legacy gemini/hybrid value (from before Phase 18) migrates automatically.
# AI_MODE still defaults to "local" -- opt into cloud_first from the Settings page
# (Task 18.3) or by setting this to cloud_first directly.
DIE_AI_MODE=local
# Plan Amendment C (Task 18.3): defaults to true so the Settings page can enable
# cloud. Set to false to fully disable cloud regardless of any other setting.
DIE_AI_ALLOW_CLOUD=true
DIE_OLLAMA_BASE_URL=http://127.0.0.1:11434
DIE_OLLAMA_MODEL=qwen3.5:9b
DIE_OLLAMA_CONTEXT=16384
DIE_OLLAMA_KEEP_ALIVE=5m
DIE_GEMINI_MODEL=

# Phase 18/D22-D24 -- the generic OpenAI-compatible cloud provider.
DIE_OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
DIE_OPENAI_COMPAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
DIE_OPENAI_COMPAT_API_KEY=
# Task 18.6 (D27): cut 150 -> 75s after Gate B-9's 7 cloud timeouts each burned
# the full 150s before the fallback ran (docs/operations/phase18-gate-b9.md).
DIE_AI_CLOUD_DEADLINE_SECONDS=75
# Task 18.6 (D27): OpenRouter's native models:[] chain, tried server-side within
# the one HTTP call on rate-limit/downtime. Comma-separated, empty disables it
# (primary model only).
DIE_OPENAI_COMPAT_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free

DIE_APP_HOST=localhost
DIE_APP_PORT=8000
DIE_DEBUG=true

DIE_DATA_DIR=data
DIE_OMNIVOICE_MODEL_PATH=models/omnivoice

DIE_FFMPEG_PATH=ffmpeg
