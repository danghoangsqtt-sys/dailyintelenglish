DIE_GEMINI_API_KEY=

# Phase 13 provider kill switch. Packaged/recovery-safe default remains gemini until
# the local runtime passes Gate A and the full real pipeline passes Gate B.
DIE_AI_MODE=gemini
DIE_OLLAMA_BASE_URL=http://127.0.0.1:11434
DIE_OLLAMA_MODEL=qwen3.5:9b
DIE_OLLAMA_CONTEXT=16384
DIE_OLLAMA_KEEP_ALIVE=5m
DIE_GEMINI_MODEL=
DIE_AI_CLOUD_FALLBACK=true

DIE_APP_HOST=localhost
DIE_APP_PORT=8000
DIE_DEBUG=true

DIE_DATA_DIR=data
DIE_OMNIVOICE_MODEL_PATH=models/omnivoice

DIE_FFMPEG_PATH=ffmpeg
