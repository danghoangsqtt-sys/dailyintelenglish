DIE_GEMINI_API_KEY=

# Phase 14 (Amendment D): local-only release path -- Gemini is dormant. Setting
# DIE_AI_MODE to gemini/hybrid also requires DIE_AI_ALLOW_CLOUD=true below, or the
# app rejects the change; this is the unsupported rollback path (ADR-001 A2), not a
# normal configuration choice.
DIE_AI_MODE=local
DIE_AI_ALLOW_CLOUD=false
DIE_OLLAMA_BASE_URL=http://127.0.0.1:11434
DIE_OLLAMA_MODEL=qwen3.5:9b
DIE_OLLAMA_CONTEXT=16384
DIE_OLLAMA_KEEP_ALIVE=5m
DIE_GEMINI_MODEL=

DIE_APP_HOST=localhost
DIE_APP_PORT=8000
DIE_DEBUG=true

DIE_DATA_DIR=data
DIE_OMNIVOICE_MODEL_PATH=models/omnivoice

DIE_FFMPEG_PATH=ffmpeg
