graph LR
    subgraph Services
        SS[ScriptService]
        LCS[LearningContentService]
        TS[TTSService]
        AS[AudioService]
        VS[VideoService]
        THS[ThumbnailService]
        YTS[YouTubePackageService]
        PS[ProjectService]
    end

    subgraph External
        GEM[Gemini API]
        OV[OmniVoice]
        ET[Edge TTS]
        FF[ffmpeg]
        PD[pydub]
        PI[Pillow]
    end

    SS --> GEM
    LCS --> GEM
    TS --> OV & ET
    AS --> FF & PD
    VS --> FF
    THS --> GEM & PI
    YTS --> GEM
    PS --> SS & LCS & TS & AS & VS & THS & YTS
