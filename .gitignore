# Gitignore — Daily Intel English Studio

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
# Task 20.2: isolated Python 3.14 environment for the SDXL image worker (keeps torch and
# diffusers, ~5.5 GB, out of the main venv and the .exe). Set up via `requirements-image.txt`.
venv-image/
*.egg-info/
dist/
build/

# Environment
.env
*.env.local

# Data (runtime — don't commit generated content)
data/projects/
data/audio/
data/video/
data/thumbnails/
data/tts_cache/
data/quality_reviews/
data/tmp/
# Phase 20: generated character/scene library and per-project shots (user content)
data/library/
data/visuals/

# Keep music library structure but not files
data/music_library/*
!data/music_library/.gitkeep

# AI Models (large binary files)
models/*
!models/.gitkeep

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# SQLite DB (runtime)
*.db
*.sqlite
*.sqlite3

# ViePilot skill mirror for local Antigravity/Gemini CLI use (regenerate with
# `vp-tools install --target antigravity`) — not project source
.agents/

# Phase 25: cached Jenny greeting/farewell audio (regenerable)
data/brand_voice/
