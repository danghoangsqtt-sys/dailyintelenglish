# Gitignore — Daily Intel English Studio

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
# Task 21.1: isolated Python 3.11 environment for Kokoro (kokoro has no Python 3.14
# support yet -- see task-21.1.md D21.1-a). Set up via `requirements-kokoro.txt`.
venv-kokoro/
# Task 21.1b: isolated Python 3.11 environment for StyleTTS 2 (styletts2's tokenizers pin
# cannot build on Python 3.14 -- see task-21.1b.md D21.1b-a). Set up via
# `requirements-styletts2.txt`.
venv-styletts2/
*.egg-info/
dist/
build/

# Environment
.env
*.env.local

# Data (runtime — don't commit generated content)
data/projects/
data/audio/
data/video/
data/thumbnails/
data/tts_cache/
data/quality_reviews/
data/tmp/

# Keep music library structure but not files
data/music_library/*
!data/music_library/.gitkeep

# AI Models (large binary files)
models/*
!models/.gitkeep

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# SQLite DB (runtime)
*.db
*.sqlite
*.sqlite3

# ViePilot skill mirror for local Antigravity/Gemini CLI use (regenerate with
# `vp-tools install --target antigravity`) — not project source
.agents/
