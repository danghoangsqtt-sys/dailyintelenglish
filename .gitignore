# Gitignore — Daily Beyond English

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
# Task 20.2: isolated Python 3.14 environment for the SDXL image worker (keeps torch and
# diffusers, ~5.5 GB, out of the main venv and the .exe). Set up via `backend/ai/image/requirements.txt`.
.venv-image/
.venv-omnivoice/
*.egg-info/
dist/
build/

# Environment
.env
*.env.local

# Local caches and IDE launch profiles
.cache/
.remotion/
frontend/static/solo-preview/
.claude/launch.json

# Data (runtime — don't commit generated content)
data/projects/
data/audio/
data/video/
data/thumbnails/
data/tts_cache/
data/tts_preview/
data/tts_voice_catalog.json
data/quality_reviews/
data/tmp/
data/backups/
data/exports/
# Phase 20: generated character/scene library and per-project shots (user content)
data/library/
data/visuals/
data/models/omnivoice/

# Keep music library structure but not files
data/music_library/*
!data/music_library/.gitkeep

# AI Models (large binary files) -- Phase 38: backend/ai/models/
backend/ai/models/*
!backend/ai/models/.gitkeep


# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# SQLite DB (runtime)
*.db
*.sqlite
*.sqlite3

# ViePilot skill mirror for local Antigravity/Gemini CLI use (regenerate with
# `vp-tools install --target antigravity`) — not project source
.agents/

# Phase 25: cached Jenny greeting/farewell audio (regenerable)
data/brand_voice/

# The owner's own background pictures and prompts (large working files)
data/assets_background/

# Demo video and its raw recordings (Task: judges demo, 2026-10-13)
demo_output/
docs/presentation/screenshots/
